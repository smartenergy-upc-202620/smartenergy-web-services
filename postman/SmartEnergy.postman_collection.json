        },
        {
          "name": "List alert rules",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/alert-rules",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alert-rules"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "Evaluate consumption above threshold (8.2 kWh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const alerts = pm.response.json().alerts;",
                  "pm.test('An alert is generated', () => pm.expect(alerts.length).to.be.above(0));",
                  "const alert = alerts.find((a) => a.ruleId === pm.environment.get('alertRuleId')) || alerts[0];",
                  "if (alert) pm.environment.set('alertId', alert.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"device-001\",\n  \"consumptionKwh\": 8.2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/alerts/evaluate",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts",
                "evaluate"
              ]
            }
          }
        },
        {
          "name": "Evaluate consumption below threshold (3.0 kWh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Rule of this run not triggered', () => pm.expect(pm.response.json().alerts.map((a) => a.ruleId)).not.to.include(pm.environment.get('alertRuleId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"device-001\",\n  \"consumptionKwh\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/alerts/evaluate",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts",
                "evaluate"
              ]
            }
          }
        },
        {
          "name": "List alerts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
