    {
      "name": "Alert Rules",
      "item": [
        {
          "name": "Create alert rule (5 kWh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('alertRuleId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"High consumption\",\n  \"thresholdKwh\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/alert-rules",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alert-rules"
              ]
            }
