            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"device-001\",\n  \"consumptionKwh\": 3.75,\n  \"measuredAt\": \"2026-10-06T10:30:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/measurements",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements"
              ]
            }
          }
        },
        {
          "name": "Create invalid measurement (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
