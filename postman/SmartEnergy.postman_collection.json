{
  "info": {
    "name": "SmartEnergy",
    "description": "SmartEnergy Sprint 1 backend. Main requests go through the API Gateway ({{gatewayUrl}}). Import postman/SmartEnergy.local.postman_environment.json and run the folders in order (Health, Authentication, Energy Measurements, Alert Rules, Alerts): test scripts store accessToken, measurementId, alertRuleId and alertId automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Gateway health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          }
        },
        {
          "name": "System health (all services via gateway)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All services up', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/system/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "system",
                "health"
              ]
            }
          }
        },
        {
          "name": "User Service health (direct)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/api/v1/health",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          }
        },
        {
          "name": "Energy Monitoring Service health (direct)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{energyServiceUrl}}/api/v1/health",
              "host": [
                "{{energyServiceUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
