          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Same alert', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('alertId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
