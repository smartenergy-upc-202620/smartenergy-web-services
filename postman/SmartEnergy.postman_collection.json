            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"\",\n  \"consumptionKwh\": -1,\n  \"measuredAt\": \"not-a-date\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/measurements",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements"
              ]
            }
          }
        },
        {
          "name": "List measurements",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/measurements",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements"
              ]
            }
          }
        },
        {
          "name": "List measurements of a device",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only device-001', () => pm.response.json().forEach((m) => pm.expect(m.deviceId).to.eql('device-001')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/measurements?deviceId=device-001",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements"
              ],
              "query": [
                {
                  "key": "deviceId",
                  "value": "device-001"
                }
              ]
            }
          }
        },
        {
          "name": "Consumption summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has totals', () => pm.expect(pm.response.json()).to.have.keys('totalMeasurements', 'totalConsumptionKwh', 'averageConsumptionKwh'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/measurements/summary",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements",
                "summary"
              ]
            }
          }
        },
        {
          "name": "Get measurement by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
