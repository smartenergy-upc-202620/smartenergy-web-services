{
  "name": "smartenergy-web-services",
  "version": "0.1.0",
  "description": "SmartEnergy backend: NestJS monorepo with API Gateway, User, Energy Monitoring and Alert services.",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "build": "pnpm run build:api-gateway && pnpm run build:user-service && pnpm run build:energy-monitoring-service && pnpm run build:alert-service",
    "build:api-gateway": "nest build api-gateway",
    "build:user-service": "nest build user-service",
    "build:energy-monitoring-service": "nest build energy-monitoring-service",
    "build:alert-service": "nest build alert-service",
    "start:api-gateway": "nest start api-gateway",
    "start:user-service": "nest start user-service",
    "start:energy-monitoring-service": "nest start energy-monitoring-service",
    "start:alert-service": "nest start alert-service",
    "start:dev": "pnpm run start:dev:all",
    "start:dev:all": "concurrently -n gateway,user,energy,alert -c blue,green,yellow,magenta \"pnpm:start:dev:api-gateway\" \"pnpm:start:dev:user-service\" \"pnpm:start:dev:energy-monitoring-service\" \"pnpm:start:dev:alert-service\"",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:dev:user-service": "nest start user-service --watch",
    "start:dev:energy-monitoring-service": "nest start energy-monitoring-service --watch",
    "start:dev:alert-service": "nest start alert-service --watch",
    "start:prod": "concurrently \"pnpm:start:prod:*\"",
    "start:prod:api-gateway": "node dist/apps/api-gateway/main",
    "start:prod:user-service": "node dist/apps/user-service/main",
    "start:prod:energy-monitoring-service": "node dist/apps/energy-monitoring-service/main",
    "start:prod:alert-service": "node dist/apps/alert-service/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "ts-run": "node -r ts-node/register/transpile-only -r tsconfig-paths/register",
    "typeorm": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run:user": "pnpm ts-run apps/user-service/src/infrastructure/persistence/typeorm/migrate.ts run",
    "migration:revert:user": "pnpm ts-run apps/user-service/src/infrastructure/persistence/typeorm/migrate.ts revert",
    "migration:generate:user": "pnpm typeorm migration:generate -d apps/user-service/src/infrastructure/persistence/typeorm/identity-access.data-source.ts",
    "migration:run:energy": "pnpm ts-run apps/energy-monitoring-service/src/infrastructure/persistence/typeorm/migrate.ts run",
    "migration:revert:energy": "pnpm ts-run apps/energy-monitoring-service/src/infrastructure/persistence/typeorm/migrate.ts revert",
    "migration:generate:energy": "pnpm typeorm migration:generate -d apps/energy-monitoring-service/src/infrastructure/persistence/typeorm/energy-monitoring.data-source.ts",
    "migration:run:alert": "pnpm ts-run apps/alert-service/src/infrastructure/persistence/typeorm/migrate.ts run",
    "migration:revert:alert": "pnpm ts-run apps/alert-service/src/infrastructure/persistence/typeorm/migrate.ts revert",
    "migration:generate:alert": "pnpm typeorm migration:generate -d apps/alert-service/src/infrastructure/persistence/typeorm/alerting.data-source.ts",
    "migration:run:all": "pnpm migration:run:user && pnpm migration:run:energy && pnpm migration:run:alert",
    "demo:seed": "node scripts/demo-seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/",
      "<rootDir>/test/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1"
    }
  }
}
