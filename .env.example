# Copy this file to `.env` and adjust the values. Never commit `.env`.

NODE_ENV=development

# HTTP ports
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ENERGY_MONITORING_SERVICE_PORT=3002
ALERT_SERVICE_PORT=3003

# Downstream service URLs used by the API Gateway
USER_SERVICE_URL=http://localhost:3001
ENERGY_MONITORING_SERVICE_URL=http://localhost:3002
ALERT_SERVICE_URL=http://localhost:3003

# PostgreSQL (used by docker-compose.yml and the services)
# One instance, one schema per Bounded Context:
# identity_access, energy_monitoring, alerting
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartenergy
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smartenergy
# Development/test only: lets each service create its schema and tables with
# TypeORM. Ignored (always false) when NODE_ENV=production. Migrations are
# future work.
DB_SYNCHRONIZE=true

# JWT (user-service). Use a long random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1h
