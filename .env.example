# Copy this file to `.env` and adjust the values. Never commit `.env`.

NODE_ENV=development

# HTTP ports
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ENERGY_MONITORING_SERVICE_PORT=3002
ALERT_SERVICE_PORT=3003

# Downstream service URLs used by the API Gateway
USER_SERVICE_URL=http://localhost:3001
ENERGY_SERVICE_URL=http://localhost:3002
ALERT_SERVICE_URL=http://localhost:3003

# --- PostgreSQL ------------------------------------------------------------------
# One instance, one schema per Bounded Context:
# identity_access, energy_monitoring, alerting
#
# Cloud: set DATABASE_URL (takes precedence over POSTGRES_*), e.g.
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
# TLS for cloud databases. DB_SSL_REJECT_UNAUTHORIZED=false accepts
# self-signed certificates (only if the provider requires it).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Local / docker-compose connection (used when DATABASE_URL is empty).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartenergy
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smartenergy

# Tables are created with migrations (pnpm migration:run:all).
# DB_SYNCHRONIZE=true is an opt-in shortcut for throwaway local databases
# only; it is ignored when NODE_ENV=production. Do not mix it with migrations
# on the same database.
DB_SYNCHRONIZE=false

# --- JWT (user-service) -----------------------------------------------------------
# Use a long random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1h
